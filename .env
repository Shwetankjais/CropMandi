# CropMandi local / hackathon configuration
# Copy this file to .env in the PROJECT ROOT before starting the backend.
# For the Harvest Route map and the four supplied crop models, no API key is required.

# Local database (SQLite). Keep this value for a normal local demo.
DATABASE_URL=sqlite:///./data/cropmandi.db

# Frontend addresses allowed to call the backend during local development.
# Keep these values when using: py -m http.server 5500
CROPMANDI_CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Optional: model used by the voice assistant (not the crop-price models).
# It is downloaded/cached on the backend computer when first prepared.
CROPMANDI_WHISPER_MODEL=base

# Optional: data.gov.in key for fetching fresh AGMARKNET/Rice records.
# Not needed just to start the app or use the supplied crop model files.
DATA_GOV_API_KEY= https://data.gov.in/?utm_source=chatgpt.com
DATA_GOV_HISTORICAL_RESOURCE_ID=35985678-0d79-46b4-9ed6-6f13308a1d24
DATA_GOV_DAILY_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# Optional: OpenRouteService key for the separate Cold Storage routing feature.
# NOT used by the Harvest Route map (Harvest Route uses OSM + public OSRM).
ORS_API_KEY= https://account.heigit.org/?utm_source=chatgpt.com
# Keep false unless you intentionally enable the optional cold-storage geocoding.
COLD_STORAGE_ENABLE_GEOCODING=false

# Optional: only fill these when connecting real Razorpay TEST MODE credentials.
# The project has a built-in demo payment mode when these are left blank.
RAZORPAY_KEY_ID= https://dashboard.razorpay.com/?utm_source=chatgpt.com
RAZORPAY_KEY_SECRET= https://dashboard.razorpay.com/?utm_source=chatgpt.com
RAZORPAY_WEBHOOK_SECRET= https://dashboard.razorpay.com/?utm_source=chatgpt.com

# Optional: coffee-board PDF ingestion settings (not needed for a normal demo).
CROPMANDI_COFFEE_PDF_DIR=
CROPMANDI_HTTP_TIMEOUT=45
